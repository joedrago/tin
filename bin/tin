#!/usr/bin/env node
// tin — start pi with a temporary set of extra write roots.
//
//     tin [-r] [DIR [DIR...]]
//     tin --setup
//
// Order does not matter. Plain `tin` is plain `pi`: the working directory is the
// only place the model may write, exactly as the extension behaves on its own.
// Every DIR named on the command line is added to that set for this one session,
// handed over in TIN_EXTRA_WRITE_ROOTS, and tin prints the roots it ended up with
// when the session opens. `-r` (resume a session) is passed through to pi.
//
// Symlink this anywhere on your PATH; it locates nothing relative to itself for
// any of the above, so a link out of the repo works with no further setup. The
// one exception is `--setup`, which has to find src/, wrappers/ and tinjs/ to
// link them, and does that by resolving its own symlink back to this file first.

import { execFileSync, spawn } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

/** Matches expandTilde in src/paths.ts, for the argument your shell did not expand. */
function expandTilde(input) {
	if (input === "~") return os.homedir();
	if (input.startsWith("~/")) return path.join(os.homedir(), input.slice(2));
	return input;
}

/** Must match EXTRA_ROOTS_ENV in src/index.ts. */
const EXTRA_ROOTS_ENV = "TIN_EXTRA_WRITE_ROOTS";

const USAGE = `usage: tin [-r] [DIR [DIR...]]
       tin --setup

  DIR      a directory the model may also write in, for this session only
  -r       passed through to pi: pick a session to resume
  --setup  link the pi extension, create ~/tinbin, link the wrappers and inert
           commands that are on your PATH, and build and link tinjs
`;

function fail(message) {
	process.stderr.write(`tin: ${message}\n`);
	process.exit(2);
}

/**
 * Read-only commands with no flag that writes a file, runs a program, or
 * reaches the network — see the "Ready-made wrappers" and "Genuinely inert"
 * sections of README.md for the reasoning behind each one. Linked directly,
 * with no wrapper needed.
 */
const INERT_COMMANDS = [
	"jq", "grep", "wc", "cut", "tr", "uniq", "comm", "diff",
	"strings", "xxd", "base64", "head", "tail", "file", "stat",
];

/** Commands where the real thing is too dangerous to link directly, and a
 * read-only policy wrapper in wrappers/ stands in for it instead. */
const WRAPPED_COMMANDS = ["git", "rg"];

if (process.argv.slice(2).includes("--setup")) {
	runSetup();
	process.exit(0);
}

const dirs = [];
const piArgs = [];

for (const arg of process.argv.slice(2)) {
	if (arg === "-h" || arg === "--help") {
		process.stdout.write(USAGE);
		process.exit(0);
	} else if (arg === "-r") {
		if (!piArgs.includes("-r")) piArgs.push("-r");
	} else if (arg.startsWith("-")) {
		fail(`unknown option ${arg}\n\n${USAGE}`);
	} else {
		dirs.push(arg);
	}
}

// Resolved here rather than left to the extension so a typo is a message from the
// shell you are still looking at, not a warning inside a session you have already
// started. The extension canonicalizes these again — symlinks and all — before it
// trusts them, so this is convenience, not the check that matters.
const roots = [];
for (const dir of dirs) {
	const resolved = path.resolve(expandTilde(dir));
	let stats;
	try {
		stats = fs.statSync(resolved);
	} catch {
		fail(`${dir}: no such directory`);
	}
	if (!stats.isDirectory()) fail(`${dir}: not a directory`);
	if (resolved.includes(path.delimiter)) {
		fail(`${resolved} contains ${path.delimiter}, which separates entries in ${EXTRA_ROOTS_ENV}`);
	}
	if (!roots.includes(resolved)) roots.push(resolved);
}

// An inherited value is dropped rather than merged: `tin` with no directories has
// to mean the working directory and nothing else, whatever is exported around it.
const env = { ...process.env };
if (roots.length > 0) env[EXTRA_ROOTS_ENV] = roots.join(path.delimiter);
else delete env[EXTRA_ROOTS_ENV];

const child = spawn("pi", piArgs, {
	stdio: "inherit",
	env,
	// On Windows pi is a .cmd shim, which Node will not start as an image. Nothing
	// from the command line reaches this argument list except the literal `-r`, so
	// there is nothing here for cmd to reinterpret.
	shell: process.platform === "win32",
});

// Ctrl-C is delivered to pi directly through the shared terminal. Without these the
// wrapper would take the default action and hand the shell back its prompt while pi
// was still drawing on the screen.
process.on("SIGINT", () => {});
process.on("SIGTERM", () => {});

child.on("error", (error) => {
	fail(error.code === "ENOENT" ? "could not find pi on PATH" : error.message);
});

child.on("exit", (code, signal) => {
	process.exit(signal ? 128 + (os.constants.signals[signal] ?? 0) : (code ?? 0));
});

// ---------------------------------------------------------------------- setup

/**
 * Find `name` the way a shell would, without spawning one: walk PATH, and on
 * Windows also try each PATHEXT suffix. Returns the full path, or null.
 */
function findOnPath(name) {
	const dirs = (process.env.PATH ?? "").split(path.delimiter).filter(Boolean);
	const exts =
		process.platform === "win32" ? (process.env.PATHEXT ?? ".EXE;.CMD;.BAT;.COM").split(";") : [""];
	for (const dir of dirs) {
		for (const ext of exts) {
			const candidate = path.join(dir, name + ext);
			try {
				if (!fs.statSync(candidate).isFile()) continue;
				fs.accessSync(candidate, fs.constants.X_OK);
				return candidate;
			} catch {
				// not here, keep looking
			}
		}
	}
	return null;
}

/**
 * Make `linkPath` a symlink to `target`, reporting what happened rather than
 * asking first. A pre-existing symlink that already points at `target` is left
 * alone and reported as such; anything else already at `linkPath` — someone
 * else's file, a symlink pointing elsewhere — is left alone too, since setup
 * should never clobber something it did not create.
 */
function ensureSymlink(target, linkPath, label, actions) {
	try {
		const st = fs.lstatSync(linkPath);
		if (st.isSymbolicLink()) {
			const current = path.resolve(path.dirname(linkPath), fs.readlinkSync(linkPath));
			actions.push(
				current === target ? `${label} already linked` : `${label}: left alone, already links elsewhere`,
			);
		} else {
			actions.push(`${label}: left alone, something else is already there`);
		}
		return;
	} catch (err) {
		if (err.code !== "ENOENT") {
			actions.push(`${label}: could not check what is there (${err.message})`);
			return;
		}
	}
	try {
		fs.symlinkSync(target, linkPath);
		actions.push(`linked ${label}`);
	} catch (err) {
		actions.push(`${label}: could not link it (${err.message})`);
	}
}

/**
 * `tin --setup`: everything the README's install block used to ask you to type
 * by hand, minus the one part that is genuinely a choice — cloning the repo in
 * the first place. Idempotent: run it again after installing a tool you did not
 * have yet, and it links only what is new.
 */
function runSetup() {
	const isWindows = process.platform === "win32";
	// Resolved from this file's own real location — the one place --setup needs
	// to know where the repo actually is, symlink or not.
	const scriptPath = fs.realpathSync(fileURLToPath(import.meta.url));
	const tinRoot = path.dirname(path.dirname(scriptPath));
	const tinbin = path.join(os.homedir(), "tinbin");
	const actions = [];

	const extensionsDir = path.join(os.homedir(), ".pi", "agent", "extensions");
	fs.mkdirSync(extensionsDir, { recursive: true });
	ensureSymlink(path.join(tinRoot, "src"), path.join(extensionsDir, "tin"), "the pi extension", actions);

	fs.mkdirSync(tinbin, { recursive: true });
	actions.push(`~/tinbin ready at ${tinbin}`);

	for (const name of WRAPPED_COMMANDS) {
		if (!findOnPath(name)) {
			actions.push(`${name}: not on PATH, skipped the read-only wrapper`);
			continue;
		}
		const fileName = isWindows ? `${name}.mjs` : name;
		const source = path.join(tinRoot, "wrappers", fileName);
		ensureSymlink(source, path.join(tinbin, fileName), `${fileName} (read-only ${name})`, actions);
	}

	for (const name of INERT_COMMANDS) {
		const found = findOnPath(name);
		if (!found) {
			actions.push(`${name}: not on PATH, skipped`);
			continue;
		}
		// Windows needs the extension on the link name too, since that is the
		// name the model calls it by.
		const linkName = isWindows ? path.basename(found) : name;
		ensureSymlink(found, path.join(tinbin, linkName), linkName, actions);
	}

	if (!findOnPath("cmake")) {
		actions.push("cmake: not on PATH, skipped building tinjs");
	} else {
		const tinjsDir = path.join(tinRoot, "tinjs");
		const buildDir = path.join(tinjsDir, "build");
		try {
			execFileSync("cmake", ["-S", tinjsDir, "-B", buildDir], { stdio: ["ignore", "ignore", "pipe"] });
			actions.push("tinjs build configured");
			execFileSync("cmake", ["--build", buildDir, "--config", "Release"], {
				stdio: ["ignore", "ignore", "pipe"],
			});
			actions.push("tinjs built");

			const builtBinary = isWindows
				? path.join(buildDir, "Release", "tinjs.exe")
				: path.join(buildDir, "tinjs");
			if (fs.existsSync(builtBinary)) {
				const linkName = isWindows ? "tinjs.exe" : "tinjs";
				ensureSymlink(builtBinary, path.join(tinbin, linkName), linkName, actions);
			} else {
				actions.push("tinjs: build finished but the binary is missing, not linked");
			}
		} catch (err) {
			const detail = err.stderr ? err.stderr.toString().trim().split("\n").pop() : err.message;
			actions.push(`tinjs: build failed (${detail})`);
		}
	}

	process.stdout.write("tin --setup\n");
	for (const action of actions) process.stdout.write(`  • ${action}\n`);
	process.stdout.write("\nDone!\n");
}
